---
/**
 * Homepage - Springboards-inspired design
 * Completely refactored with new component system
 */

import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/home/Hero.astro';
import Offerings from '@/components/sections/home/Offerings.astro';
import WorkShowcase from '@/components/sections/home/WorkShowcase.astro';
import Philosophy from '@/components/sections/home/Philosophy.astro';
import PartnerLogos from '@/components/sections/home/PartnerLogos.astro';

export const prerender = true;

// Fetch partner logos from content if still used
const siteContent = await getCollection('site-content');
const homeEntry = siteContent.find(entry => entry.id === 'home');

interface HomeSection {
  section: string;
  content: {
    title?: string;
    logos?: Array<{ name: string; url: string; alt: string }>;
    [key: string]: unknown;
  };
}

const homeSections = (homeEntry?.data || []) as HomeSection[];
const partnersContent = homeSections.find(section => section.section === 'partners')?.content;
---

<BaseLayout title="Service Design That Transforms | Dale Rogers">
  <Hero />
  <Offerings />
  <WorkShowcase />
  <Philosophy />
  {
    partnersContent?.logos && (
      <PartnerLogos title={partnersContent.title || 'Trusted By'} logos={partnersContent.logos} />
    )
  }
</BaseLayout>
