---
/**
 * Articles Index Page - Springboards-inspired design
 * Grid of article cards with modern layout
 */

import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';

import Layout from '@/layouts/BaseLayout.astro';
import CardArticle from '@/components/ui/CardArticle.astro';
import Pagination from '@/components/ui/Pagination.astro';
import Heading from '@/components/ui/Heading.astro';
import Container from '@/components/layout/Container.astro';
import '@/styles/components/section.css';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const ITEMS_PER_PAGE = 6;

  const articles = await getCollection('articles', ({ data }) => !data.draft);

  const sortedArticles = articles.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(sortedArticles, {
    pageSize: ITEMS_PER_PAGE,
  });
};

interface Props {
  page: {
    data: CollectionEntry<'articles'>[];
    currentPage: number;
    lastPage: number;
  };
}

const { page } = Astro.props as Props;

const getPageUrl = (pageNum: number) => {
  return pageNum === 1 ? '/articles/1' : `/articles/${pageNum}`;
};

// Helper function to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-AU', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
};

// Helper function to calculate reading time
const calculateReadingTime = (content: string) => {
  const wordsPerMinute = 200;
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
};
---

<Layout
  title="Articles & Insights | Dale Rogers - Service Designer"
  description="Thoughts and insights on service design, digital strategy, and solving complex problems."
>
  <section class="section">
    <Container>
      <!-- Page Header -->
      <div class="section__header">
        <Heading level={1} variant="hero" kicker="Insights">Articles & Thoughts</Heading>
        <p class="section__subtitle">
          Thoughts and insights on service design, digital strategy, and solving complex problems.
        </p>
      </div>

      <!-- Results Summary -->
      {
        page.lastPage > 1 && (
          <div style="text-align: center; margin-bottom: 2rem;">
            <p style="color: var(--color-text-tertiary); font-size: 0.875rem;">
              Page {page.currentPage} of {page.lastPage}
            </p>
          </div>
        )
      }

      <!-- Articles Grid -->
      <div class="cards-grid cards-grid--3" role="list" aria-label="Articles">
        {
          page.data.map(article => (
            <CardArticle
              title={article.data.title}
              excerpt={article.data.description}
              date={formatDate(article.data.pubDate)}
              image={article.data.coverImage}
              href={`/articles/${article.slug}`}
              tags={article.data.tags}
            />
          ))
        }
      </div>

      <!-- Pagination -->
      {
        page.lastPage > 1 && (
          <div style="margin-top: 4rem;">
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              getPageUrl={getPageUrl}
            />
          </div>
        )
      }
    </Container>
  </section>
</Layout>
