---
import Layout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import PageHeader from '@/components/ui/PageHeader.astro';

export const prerender = true;
---

<Layout title="Capabilities | Dale Rogers - Service Designer and Digital Strategist">
  <main class="pt-32 md:pt-40">
    <Container narrow={true}>
      <PageHeader
        title="Capabilities"
        description="Comprehensive service design capabilities to help organizations create better experiences"
      />
    </Container>

    <Container>
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div>
          <p class="mb-4 text-lg" style="color: var(--color-text-secondary);">
            I offer a comprehensive range of service design capabilities to help organizations
            create better experiences for their users.
          </p>
          <p class="mb-4 text-lg" style="color: var(--color-text-secondary);">
            From research to implementation, I work closely with clients to understand their needs
            and deliver solutions that drive meaningful change.
          </p>
          <a
            href="/contact"
            class="inline-block px-8 py-4 rounded-full font-semibold transition-colors"
            style="background-color: var(--color-primary-main); color: var(--color-primary-contrast);"
          >
            Get in Touch
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            Service Strategy
          </h3>
          <p style="color: var(--color-text-secondary);">
            Developing service visions and strategies that align with business goals and user needs.
          </p>
        </div>

        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            User Research
          </h3>
          <p style="color: var(--color-text-secondary);">
            Conducting qualitative and quantitative research to understand user needs and behaviors.
          </p>
        </div>

        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            Service Blueprinting
          </h3>
          <p style="color: var(--color-text-secondary);">
            Mapping service experiences to identify pain points and opportunities for improvement.
          </p>
        </div>

        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            Co-design
          </h3>
          <p style="color: var(--color-text-secondary);">
            Facilitating collaborative design sessions with stakeholders and users.
          </p>
        </div>

        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            Evaluation
          </h3>
          <p style="color: var(--color-text-secondary);">
            Measuring service performance and impact through metrics and user feedback.
          </p>
        </div>

        <div
          class="rounded-2xl p-8 shadow-lg"
          style="background-color: var(--color-background-secondary);"
        >
          <h3 class="font-semibold text-xl mb-4" style="color: var(--color-text-primary);">
            Digital Transformation
          </h3>
          <p style="color: var(--color-text-secondary);">
            Modernizing legacy systems with user-first approach and strategic thinking.
          </p>
        </div>
      </div>
    </Container>
  </main>
</Layout>
