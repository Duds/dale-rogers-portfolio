---
/**
 * Work Index Page - Springboards-inspired design
 * Grid of work cards with modern layout
 */

import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';

import Layout from '@/layouts/BaseLayout.astro';
import CardWork from '@/components/ui/CardWork.astro';
import Pagination from '@/components/ui/Pagination.astro';
import Heading from '@/components/ui/Heading.astro';
import Container from '@/components/layout/Container.astro';
import '@/styles/components/section.css';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const ITEMS_PER_PAGE = 6;

  const caseStudies = await getCollection('case-studies');

  const sortedCaseStudies = caseStudies.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(sortedCaseStudies, {
    pageSize: ITEMS_PER_PAGE,
  });
};

interface Props {
  page: {
    data: CollectionEntry<'case-studies'>[];
    currentPage: number;
    lastPage: number;
  };
}

const { page } = Astro.props as Props;

const getPageUrl = (pageNum: number) => {
  return pageNum === 1 ? '/work/1' : `/work/${pageNum}`;
};
---

<Layout
  title="Selected Work | Dale Rogers - Service Designer"
  description="Real-world service design projects that delivered measurable impact for government and enterprise organisations."
>
  <section class="section">
    <Container>
      <!-- Page Header -->
      <div class="section__header">
        <Heading level={1} variant="hero" kicker="Portfolio">Selected Work</Heading>
        <p class="section__subtitle">
          Real-world service design projects that delivered measurable impact for government and
          enterprise organisations.
        </p>
      </div>

      <!-- Results Summary -->
      {
        page.lastPage > 1 && (
          <div style="text-align: center; margin-bottom: 2rem;">
            <p style="color: var(--color-text-tertiary); font-size: 0.875rem;">
              Page {page.currentPage} of {page.lastPage}
            </p>
          </div>
        )
      }

      <!-- Work Grid -->
      <div class="cards-grid cards-grid--2" role="list" aria-label="Case studies">
        {
          page.data.map(study => (
            <CardWork
              title={study.data.title}
              client={study.data.client}
              excerpt={study.data.description}
              image={study.data.image?.src || study.data.coverImage}
              href={`/work/${study.slug}`}
              tags={study.data.tags}
            />
          ))
        }
      </div>

      <!-- Pagination -->
      {
        page.lastPage > 1 && (
          <div style="margin-top: 4rem;">
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              getPageUrl={getPageUrl}
            />
          </div>
        )
      }
    </Container>
  </section>
</Layout>
