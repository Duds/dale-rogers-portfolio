---
/**
 * Contact Page - Springboards-inspired simplified design
 * Large heading, minimal contact options
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import '@/styles/components/section.css';

export const prerender = true;
---

<BaseLayout title="Get in Touch | Dale Rogers - Service Designer">
  <section class="section section--hero">
    <Container>
      <div style="text-center: center; max-width: 900px; margin: 0 auto;">
        <Heading level={1} variant="display" align="center">Let's Talk</Heading>

        <p
          style="font-size: 1.25rem; line-height: 1.7; color: var(--color-text-secondary); max-width: 700px; margin: 2rem auto 3rem;"
        >
          Ready to transform your service delivery? Whether you're tackling a wicked problem or
          looking to build capability, I'm here to help.
        </p>

        <div style="display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
          <!-- Email (decoded client-side to prevent scraping) -->
          <a
            id="contact-email"
            href="#"
            style="font-size: 1.5rem; font-weight: 700; color: var(--color-secondary-main); text-decoration: none; transition: color 0.2s;"
            aria-label="Email address"
          >
            [Loading email...]
          </a>

          <!-- Social Links -->
          <div style="display: flex; gap: 2rem; margin-top: 1rem;">
            <a
              href="https://linkedin.com/in/dalerogers"
              target="_blank"
              rel="noopener noreferrer"
              style="font-size: 1.125rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s;"
              onmouseover="this.style.color='var(--color-secondary-main)'"
              onmouseout="this.style.color='var(--color-text-secondary)'"
            >
              LinkedIn
            </a>
            <a
              href="https://medium.com/@dalerogers"
              target="_blank"
              rel="noopener noreferrer"
              style="font-size: 1.125rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s;"
              onmouseover="this.style.color='var(--color-secondary-main)'"
              onmouseout="this.style.color='var(--color-text-secondary)'"
            >
              Medium
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Availability Section -->
  <section class="section section--dark">
    <Container narrow>
      <div style="text-align: center;">
        <Heading level={2} variant="subsection" align="center">Availability</Heading>

        <div
          style="display: grid; gap: 2rem; margin-top: 2rem; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto;"
        >
          <div>
            <h3
              style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.5rem;"
            >
              Office Hours (AEST)
            </h3>
            <p style="font-size: 1.125rem; color: var(--color-text-secondary);">
              Monday - Friday: 09:00 - 17:00
            </p>
          </div>

          <div>
            <h3
              style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.5rem;"
            >
              Response Time
            </h3>
            <p style="font-size: 1.125rem; color: var(--color-text-secondary);">
              Same-day response during business hours. 24-hour response for urgent matters.
            </p>
          </div>

          <div>
            <h3
              style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.5rem;"
            >
              Location
            </h3>
            <p style="font-size: 1.125rem; color: var(--color-text-secondary);">
              Based in Canberra (Ngunnawal Country). Available for virtual meetings Australia-wide,
              and in-person workshops when needed.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Acknowledgement Section -->
  <section class="section">
    <Container narrow>
      <div style="text-align: center; max-width: 700px; margin: 0 auto;">
        <p
          style="font-size: 1.125rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: 1rem;"
        >
          I acknowledge the Ngunnawal people as the traditional custodians of the land. I pay my
          respects to Elders past, present and emerging.
        </p>
        <p style="font-size: 1.25rem; font-weight: 600; color: var(--color-text-primary);">
          Always Was, Always Will Be
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // Base64 encoded email to prevent scraping
  const encodedEmail = 'aGVsbG9AZGFsZXJvZ2Vycy5jb20uYXU='; // hello@dalerogers.com.au

  // Function to decode and display email
  function initializeEmail(): void {
    try {
      const emailLink = document.getElementById('contact-email') as HTMLAnchorElement | null;
      if (!emailLink) {
        console.error('Email link element not found');
        return;
      }

      // Decode the Base64 email address
      const decodedEmail = atob(encodedEmail);

      // Update the email link
      emailLink.href = `mailto:${decodedEmail}`;
      emailLink.textContent = decodedEmail;
    } catch (error) {
      console.error('Failed to decode email:', error);
      const emailLink = document.getElementById('contact-email');
      if (emailLink) {
        emailLink.textContent = '[Error loading email]';
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeEmail);
  } else {
    initializeEmail();
  }
</script>
