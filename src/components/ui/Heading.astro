---
/**
 * @fileoverview Heading component with multiple variants for consistent typography
 * Springboards-inspired bold, impactful headings
 */

interface Props {
  /** Heading level (h1-h6) */
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Variant style */
  variant?: 'display' | 'hero' | 'section' | 'subsection' | 'default';
  /** Optional kicker text above heading */
  kicker?: string;
  /** Alignment */
  align?: 'left' | 'center' | 'right';
  /** Additional CSS classes */
  class?: string;
  /** ID for heading anchor */
  id?: string;
}

const {
  level = 2,
  variant = 'default',
  kicker,
  align = 'left',
  class: className,
  id,
} = Astro.props;

const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

const variantClasses = {
  display: 'text-display',
  hero: 'text-5xl md:text-6xl lg:text-7xl font-black tracking-tight',
  section: 'text-4xl md:text-5xl lg:text-6xl font-black tracking-tight',
  subsection: 'text-3xl md:text-4xl font-bold tracking-tight',
  default: '',
};

const alignmentClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const classes = [variantClasses[variant], alignmentClasses[align], className]
  .filter(Boolean)
  .join(' ');
---

<div class={`heading-wrapper ${alignmentClasses[align]}`}>
  {
    kicker && (
      <p class="text-kicker mb-4" style={{ color: 'var(--color-secondary-main)' }}>
        {kicker}
      </p>
    )
  }
  <Tag class={classes} id={id} style={{ color: 'var(--color-text-primary)' }}>
    <slot />
  </Tag>
</div>

<style>
  .heading-wrapper {
    margin-bottom: 1.5rem;
  }
</style>
