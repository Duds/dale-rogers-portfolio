---
import { ChevronRight } from 'lucide-astro';
import '@/styles/components/case-studies.css';

interface Props {
  title: string;
  description: string;
  client: string;
  industry: string;
  duration: string;
  tags: string[];
  href: string;
  coverImage?: string;
}

const { title, description, client, industry, duration, tags, href, coverImage } = Astro.props;
---

<article class="case-study-card group" data-industry={industry} data-tags={tags.join(',')}>
  {
    coverImage && (
      <div class="case-study-card__image-container">
        <img
          src={coverImage}
          alt={`Cover image for ${title}`}
          class="case-study-card__image"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
        />
        <div class="case-study-card__overlay" />

        <div class="absolute top-4 left-4 flex flex-col gap-2 max-w-[calc(100%-2rem)]">
          <span class="case-study-card__client-badge">{client}</span>
          <span class="case-study-card__industry-badge">{industry}</span>
        </div>
      </div>
    )
  }

  <div class="case-study-card__content">
    <!-- Title with enhanced typography -->
    <h3 class="mb-6">
      <a href={href} aria-label={`View case study: ${title}`} class="case-study-card__title">
        {title}
      </a>
    </h3>

    <!-- Description with improved readability -->
    <p class="case-study-card__description">
      {description}
    </p>

    <!-- Project metadata with better organization -->
    <div class="case-study-card__metadata">
      <div class="case-study-card__metadata-grid">
        <div class="case-study-card__metadata-item">
          <span class="case-study-card__metadata-label"> Duration </span>
          <span class="case-study-card__metadata-value">
            {duration}
          </span>
        </div>
      </div>
    </div>

    <!-- Tags with badge styling -->
    <div class="case-study-card__tags mb-6">
      {
        tags.slice(0, 3).map(tag => (
          <a
            href={`/tags/${tag.toLowerCase()}`}
            class="case-study-card__tag"
            aria-label={`View tag: ${tag}`}
          >
            {tag}
          </a>
        ))
      }
      {
        tags.length > 3 && (
          <span class="case-study-card__tag-overflow">+{tags.length - 3} more</span>
        )
      }
    </div>

    <!-- View case study link -->
    <div class="case-study-card__link-section">
      <a href={href} aria-label={`View case study: ${title}`} class="case-study-card__link">
        View Case Study
        <ChevronRight class="case-study-card__link-icon" />
      </a>
    </div>
  </div>

  <!-- Subtle background pattern -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-purple-50/30 dark:to-purple-900/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-3xl"
  >
  </div>
</article>
