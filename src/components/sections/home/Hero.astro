---
/**
 * Hero section - Springboards-inspired bold, centered layout
 * @component Hero
 * @description Massive headline with centered layout and prominent CTAs
 * @australian-english
 * @accessibility Full WCAG AAA compliance with semantic HTML
 */

import Button from '@/components/ui/Button.astro';
import '@/styles/components/hero.css';

// Content - Punchy and impactful
const headline = 'Service Design That Transforms';
const subheadline = 'Designing services, not just interfaces. Creating value, not just artifacts.';
---

<section class="hero-modern" aria-label="Hero introduction">
  <div class="hero-modern__content">
    <h1 class="hero-modern__headline">
      {headline}
    </h1>

    <p class="hero-modern__subheadline">
      {subheadline}
    </p>

    <div class="hero-modern__actions">
      <Button variant="primary" size="xl" href="/work"> View Work </Button>
      <Button variant="ghost" size="xl" href="/contact"> Get Started </Button>
    </div>
  </div>

  <!-- Optional scroll indicator -->
  <div class="hero-modern__scroll-indicator" aria-hidden="true">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </div>
</section>
