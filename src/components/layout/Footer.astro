---
/**
 * Footer component - Springboards-inspired simplified design
 * Centered, minimal layout with essential links
 */

import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import VersionBadge from '@/components/ui/VersionBadge.astro';
import '@/styles/components/footer-modern.css';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { name: 'Work', href: '/work' },
  { name: 'Articles', href: '/articles' },
  { name: 'Contact', href: '/contact' },
  { name: 'Privacy', href: '/privacy' },
  { name: 'Terms', href: '/terms' },
];

const socialLinks = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/dalerogers' },
  { name: 'Medium', href: 'https://medium.com/@dalerogers' },
];
---

<footer class="footer-modern">
  <Container>
    <!-- Acknowledgement of Country -->
    <div class="footer-modern__acknowledgement">
      <p class="footer-modern__acknowledgement-text">
        I acknowledge the Ngunnawal people as the traditional custodians of the land. I pay my
        respects to Elders past, present and emerging.
      </p>
      <p class="footer-modern__acknowledgement-slogan">Always Was, Always Will Be</p>
    </div>

    <!-- CTA Section -->
    <div class="footer-modern__cta">
      <h2 class="footer-modern__cta-heading">Let's Transform Services Together</h2>
      <Button variant="primary" size="xl" href="/contact">Get in Touch</Button>
    </div>

    <!-- Links -->
    <div class="footer-modern__links">
      <nav aria-label="Footer navigation">
        <ul class="footer-modern__nav">
          {
            footerLinks.map(link => (
              <li>
                <a href={link.href} class="footer-modern__link">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-modern__social">
        {
          socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-modern__social-link"
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-modern__copyright">
      <p>&copy; {currentYear} Dale Rogers. All rights reserved.</p>
      <div class="footer-modern__meta">
        <VersionBadge />
        <p>Made with ❤️ in Canberra (Ngunnawal Country)</p>
      </div>
    </div>
  </Container>
</footer>
