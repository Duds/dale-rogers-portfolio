---
/**
 * Case Study Layout - Springboards-inspired design
 * Full-width hero, centered content, clean presentation
 */

import BaseLayout from './BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import CardWork from '@/components/ui/CardWork.astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import '@/styles/components/case-study-modern.css';

interface Props {
  caseStudy: CollectionEntry<'case-studies'>;
}

const { caseStudy } = Astro.props;
const {
  title,
  description,
  tags,
  coverImage,
  client,
  industry,
  duration,
  challenge,
  solution,
  results,
} = caseStudy.data;

// Related case studies: simple match by overlapping tags, exclude current
const allCaseStudies = await getCollection('case-studies');
const related = allCaseStudies
  .filter(s => s.slug !== caseStudy.slug)
  .map(s => ({
    slug: s.slug,
    title: s.data.title,
    coverImage: s.data.coverImage || s.data.image?.src,
    client: s.data.client,
    industry: s.data.industry,
    tags: s.data.tags,
    description: s.data.description,
    score: (s.data.tags || []).filter((t: string) => (tags || []).includes(t)).length,
  }))
  .filter(r => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);
---

<BaseLayout title={title} description={description} image={coverImage}>
  <!-- Hero Section -->
  <section class="case-study-hero">
    {coverImage && <img src={coverImage} alt={title} class="case-study-hero__image" />}
    <div class="case-study-hero__overlay"></div>
    <Container class="case-study-hero__content">
      <div class="case-study-hero__meta">
        <span class="case-study-hero__meta-item">{client}</span>
        <span class="case-study-hero__meta-item">•</span>
        <span class="case-study-hero__meta-item">{industry}</span>
        <span class="case-study-hero__meta-item">•</span>
        <span class="case-study-hero__meta-item">{duration}</span>
      </div>
      <h1 class="case-study-hero__title">{title}</h1>
      <p class="case-study-hero__description">{description}</p>
    </Container>
  </section>

  <!-- Overview Cards -->
  <section class="case-study-overview">
    <Container>
      <div class="case-study-overview__grid">
        <!-- Challenge -->
        <div class="case-study-overview__card">
          <h2 class="case-study-overview__card-title">Challenge</h2>
          <p class="case-study-overview__card-content">{challenge}</p>
        </div>

        <!-- Solution -->
        <div class="case-study-overview__card">
          <h2 class="case-study-overview__card-title">Solution</h2>
          <p class="case-study-overview__card-content">{solution}</p>
        </div>

        <!-- Results -->
        <div class="case-study-overview__card">
          <h2 class="case-study-overview__card-title">Results</h2>
          {
            Array.isArray(results) ? (
              <ul class="case-study-overview__card-list">
                {results.map(result => (
                  <li class="case-study-overview__card-list-item">{result}</li>
                ))}
              </ul>
            ) : (
              <p class="case-study-overview__card-content">{results}</p>
            )
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Main Content -->
  <section class="case-study-content">
    <Container narrow>
      <div class="case-study-content__inner">
        <slot />
      </div>
    </Container>
  </section>

  <!-- Related Work -->
  {
    related.length > 0 && (
      <section class="case-study-related">
        <Container>
          <div class="case-study-related__header">
            <h2 class="case-study-related__title">Related Work</h2>
            <p class="case-study-related__subtitle">Explore similar projects</p>
          </div>

          <div class="cards-grid cards-grid--3">
            {related.map(r => (
              <CardWork
                title={r.title}
                client={r.client}
                excerpt={r.description}
                image={r.coverImage}
                href={`/work/${r.slug}`}
                tags={r.tags}
              />
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
